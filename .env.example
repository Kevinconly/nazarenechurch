# Backend settings (copy to backend/.env for local use).
# For Docker Compose, copy this file to .env at the repository root and set
# real values there. Never commit either file.
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/remera_archive
# Optional: path to the PostgreSQL CA certificate for verified TLS. In a
# container this path must exist inside the container; mount it read-only.
DATABASE_SSL_CA_FILE=
# Required in production: generate at least 32 random bytes and keep this secret.
SESSION_SECRET=
# Set NODE_ENV=production behind HTTPS; cookie Secure is enabled automatically there.
NODE_ENV=development
# Optional local HTTPS override for the session cookie.
SESSION_COOKIE_SECURE=false
# Number of trusted TLS-terminating proxy hops (leave at 0 unless deployment requires it).
# Docker Compose with the bundled nginx proxy uses 1. ALB + nginx uses 2.
TRUST_PROXY_HOPS=0

# Docker Compose only: public port for the nginx frontend.
HTTP_PORT=8080
IMAGE_TAG=latest

# Public browser configuration for the Supabase-backed gallery (not secrets).
# These values are embedded in the frontend image at build time.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
