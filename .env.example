# Backend settings (copy to backend/.env for local use)
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/remera_archive
# Optional: path to the Supabase database CA certificate for verified TLS.
DATABASE_SSL_CA_FILE=
# Required in production: generate at least 32 random bytes and keep this secret.
SESSION_SECRET=
# Set NODE_ENV=production behind HTTPS; cookie Secure is enabled automatically there.
NODE_ENV=development
# Optional local HTTPS override for the session cookie.
SESSION_COOKIE_SECURE=false
# Number of trusted TLS-terminating proxy hops (leave at 0 unless deployment requires it).
TRUST_PROXY_HOPS=0
